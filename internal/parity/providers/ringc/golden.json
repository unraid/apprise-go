        "method": "POST",
        "url": "https://platform.ringcentral.com/restapi/oauth/token"
      },
      {
        "body": "{\"from\": {\"phoneNumber\": \"+15551234567\"}, \"to\": [{\"phoneNumber\": \"+15559876543\"}], \"text\": \"apprise parity\\r\\nhello from python\"}",
