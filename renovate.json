{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["gomod", "github-actions"],
  "separateMinorPatch": true,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": false,
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "packageRules": [
    {
      "description": "Automerge stable Go module patches after parity and race tests.",
      "matchManagers": ["gomod"],
      "matchDatasources": ["go"],
      "matchCurrentVersion": "/^v?[1-9][0-9]*\\.[0-9]+\\.[0-9]+$/",
      "matchUpdateTypes": ["patch"],
      "minimumReleaseAge": "3 days",
      "automerge": true
    },
    {
      "description": "Automerge GitHub Action and reusable workflow updates after parity and race tests.",
      "matchManagers": ["github-actions"],
      "matchDepTypes": ["action", "workflow"],
      "automerge": true
    }
  ]
}
